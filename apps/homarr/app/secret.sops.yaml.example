# 1. Fill in the key below:  openssl rand -hex 32
#    Homarr encrypts integration API keys in its DB with it. Losing it means
#    re-entering every integration secret, so keep a copy outside the cluster.
# 2. Save as secret.sops.yaml, then: sops -e -i secret.sops.yaml
---
apiVersion: v1
kind: Secret
metadata:
  name: db-encryption
  namespace: homarr
stringData:
  db-encryption-key: "REPLACE_ME"
