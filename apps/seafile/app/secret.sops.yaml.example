# 1. Fill in the values below:
#      JWT_PRIVATE_KEY                  openssl rand -base64 32   (>= 32 chars, required)
#      SEAFILE_MYSQL_DB_PASSWORD        openssl rand -base64 24
#      INIT_SEAFILE_MYSQL_ROOT_PASSWORD openssl rand -base64 24
#      INIT_SEAFILE_ADMIN_PASSWORD      your admin login password (Seahub web UI)
#      REDIS_PASSWORD                   openssl rand -base64 24
# 2. Save as secret.sops.yaml ; sops -e -i secret.sops.yaml
# 3. Uncomment secret.sops.yaml in kustomization.yaml
#
# The whole secret is mounted with envFrom into the Seafile container, so every
# key here becomes an env var there. JWT_PRIVATE_KEY is shared with the
# notification server — both must see the same value or clients fail to
# authenticate against it.
---
apiVersion: v1
kind: Secret
metadata:
  name: seafile-secret
  namespace: seafile
stringData:
  JWT_PRIVATE_KEY: "REPLACE_ME"
  SEAFILE_MYSQL_DB_PASSWORD: "REPLACE_ME"
  INIT_SEAFILE_MYSQL_ROOT_PASSWORD: "REPLACE_ME"
  INIT_SEAFILE_ADMIN_PASSWORD: "REPLACE_ME"
  # Redis is started with --requirepass $(REDIS_PASSWORD) (upstream's own
  # invocation), and Seafile reads the same key — so this must be a real value,
  # not empty: openssl rand -base64 24
  REDIS_PASSWORD: "REPLACE_ME"
