# 1. Fill in values (PAPERLESS_SECRET_KEY: e.g. `openssl rand -base64 48`)
# 2. Save as secret.sops.yaml ;  sops -e -i secret.sops.yaml
# 3. Uncomment in kustomization.yaml
---
apiVersion: v1
kind: Secret
metadata:
  name: paperless-secret
  namespace: paperless
stringData:
  PAPERLESS_SECRET_KEY: "REPLACE_ME"
  PAPERLESS_ADMIN_USER: "REPLACE_ME"
  PAPERLESS_ADMIN_PASSWORD: "REPLACE_ME"
