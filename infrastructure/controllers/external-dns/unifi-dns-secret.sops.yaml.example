# 1. UniFi console (by IP) -> Settings -> Control Plane -> Integrations -> Create API Key.
#    Least privilege: a dedicated `external-dns` user, key created while it is
#    Super Admin, then the user downgraded to Site Admin (the key keeps working).
# 2. Fill it in below, save as unifi-dns-secret.sops.yaml
# 3. sops -e -i unifi-dns-secret.sops.yaml
# 4. Uncomment `- external-dns` in infrastructure/controllers/kustomization.yaml
---
apiVersion: v1
kind: Secret
metadata:
  name: unifi-dns-secret
  namespace: external-dns
stringData:
  UNIFI_API_KEY: "REPLACE_ME"
